# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
RAGAS_MODEL=openai/gpt-4o-mini
RAGAS_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: set LLM_PROVIDER=openai and use native OpenAI model IDs.
OPENAI_API_KEY=
